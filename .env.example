# Copy to ".env" and fill in. NEVER commit the real .env or credentials.json.

# --- Google ---
# Path to the service-account JSON key (share the Sheet with its client_email!).
GOOGLE_CREDENTIALS_FILE=credentials.json
# The id from the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
SPREADSHEET_ID=

# --- Worksheet (tab) captions — must match the Google Sheet exactly ---
SHEET_READY_CUT=Готовый крой
SHEET_CUTTING_PLAN=План кроя
SHEET_SEWING_PLAN=План пошива
SHEET_TRANSFER_ALERTS=Перемещения
SHEET_DISTRIBUTION=Бестселлеры к распределению
SHEET_STOCK_RAW=Остатки по складам

# --- Warehouse topology ---
# Retail stores to keep stocked (semicolon-separated).
TARGET_STORES_CSV=Авиапарк ТЦ;Европейский ТЦ;ЖаПримерка;Склад химчистка;Склад ремонт;Химчистка Ави
# Finished-goods warehouse name as it appears in the stock export.
FINISHED_GOODS_WAREHOUSE=ЕСклад ГП

# --- Deficit thresholds ---
TARGET_STORE_STOCK=3     # desired units per store
MIN_STORE_STOCK=1        # on_hand below this == "missing"

# --- Priority ---
HIGH_PRIORITY_TOP_N=50           # top-N by revenue are "high rating"
MIN_REVENUE_THRESHOLD=0          # OR: revenue >= this (0 = disabled)

# --- Google API retry / backoff ---
MAX_RETRIES=5
BACKOFF_INITIAL=1.0
BACKOFF_BASE=2.0
BACKOFF_MAX=60.0

# --- Matching overrides ---
MAPPINGS_FILE=mappings.json
